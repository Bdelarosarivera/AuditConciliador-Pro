rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Role Fetching (Auth tokens do not have claims by default; fetch from /users/{userId})
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserActive() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().status == 'active';
    }

    function hasAdminRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'Admin';
    }

    function hasAuditorRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserData().role == 'Auditor' || getUserData().role == 'Admin' || getUserData().role == 'Supervisor');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Rules ---
    
    // User Profile
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt', 'status'])
        && data.keys().size() >= 6 && data.keys().size() <= 8
        && data.uid is string && data.uid.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.email is string && data.email.size() <= 200
        && data.role in ['Admin', 'Auditor', 'Supervisor', 'Viewer']
        && data.createdAt is string
        && data.status in ['active', 'suspended'];
    }

    // Audit Header
    function isValidAudit(data) {
      return data.keys().hasAll(['auditName', 'uploadedBy', 'uploadedAt', 'status', 'summary', 'createdAt'])
        && data.auditName is string && data.auditName.size() <= 200
        && data.uploadedBy is string && data.uploadedBy.size() <= 128
        && data.uploadedBy == request.auth.uid
        && data.status in ['draft', 'approved', 'finalized']
        && data.summary is map
        && data.createdAt is string;
    }

    // Inventory Item
    function isValidInventoryItem(data) {
      return data.keys().hasAll(['code', 'description', 'classification', 'physical', 'theoretical', 'cost', 'difference', 'differenceRD', 'createdAt'])
        && data.code is string && data.code.size() <= 100
        && data.description is string && data.description.size() <= 500
        && data.classification in ['A', 'B', 'C']
        && data.physical is number
        && data.theoretical is number
        && data.cost is number
        && data.difference is number
        && data.differenceRD is number
        && data.createdAt is string;
    }

    // Executive Report
    function isValidReport(data) {
      return data.keys().hasAll(['auditId', 'generatedBy', 'generatedAt', 'executiveSummary', 'recommendations'])
        && data.auditId is string && data.auditId.size() <= 128
        && data.generatedBy is string && data.generatedBy.size() <= 128
        && data.generatedBy == request.auth.uid
        && data.executiveSummary is string && data.executiveSummary.size() <= 10000
        && data.recommendations is list;
    }

    // --- Path Matching ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      
      // Creating is allowed for Google/Email auth initial login
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) 
                     && (incoming().role != 'Admin' || request.auth.token.email.lower() == 'bartolodelarosarivera@gmail.com')
                     && incoming().status == 'active';
                     
      // Updating profile (Only owner can update non-critical fields, Admin has full rights)
      allow update: if isSignedIn() && (isOwner(userId) || hasAdminRole()) && isValidUser(incoming());

      // Admin has full control
      allow write: if hasAdminRole();
    }

    match /audits/{auditId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() && isValidAudit(incoming());

      // Only owner auditor or admin can update audits.
      allow update: if isSignedIn() && (isOwner(existing().uploadedBy) || hasAdminRole()) && isValidAudit(incoming());

      allow delete: if hasAdminRole();
    }

    match /audits/{auditId}/inventoryItems/{itemId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() && isValidInventoryItem(incoming());

      allow update: if isSignedIn() && isValidInventoryItem(incoming());

      allow delete: if isSignedIn() && (isOwner(get(/databases/$(database)/documents/audits/$(auditId)).data.uploadedBy) || hasAdminRole());
    }

    match /reports/{reportId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() && isValidReport(incoming());

      allow update: if isSignedIn() && isValidReport(incoming())
                    && incoming().auditId == existing().auditId;

      allow delete: if hasAdminRole();
    }
  }
}
